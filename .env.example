# Local development settings
APP_NAME="Entity Resolver API"
APP_VERSION="0.1.0"
DEBUG=false
WIKIDATA_TIMEOUT=10
# Optional override; otherwise use the bundled company index.
# ALIAS_INDEX_PATH=src/entity_resolver/data/companies.json
MATCH_THRESHOLD=0.8

# Artificial delay for concurrency experiments; keep 0 for normal use.
MODEL_DELAY_SECONDS=0

# GLEIF tiebreak for low-confidence matches (calls the public GLEIF API).
GLEIF_ENABLED=false
GLEIF_LOW_THRESHOLD=0.6
GLEIF_DAILY_BUDGET=1000
GLEIF_TIMEOUT=5

# Spreadsheet upload limits. Files are deleted upload_ttl_seconds after upload.
# UPLOAD_DIR=/tmp/entity-resolver-uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_ROWS=5000
UPLOAD_TTL_SECONDS=3600
UPLOAD_MAX_RUNNING=3
