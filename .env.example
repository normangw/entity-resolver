# Local development settings
APP_NAME="Entity Resolver API"
APP_VERSION="0.1.0"
DEBUG=false
WIKIDATA_TIMEOUT=10
# Ask Wikidata when a name is not in the local index (resolves subsidiaries).
WIKIDATA_FALLBACK=true
# Seconds to remember a Wikidata answer; 0 turns the cache off.
WIKIDATA_CACHE_TTL=3600
# Optional override; otherwise use the bundled company index.
# ALIAS_INDEX_PATH=src/entity_resolver/data/companies.json
MATCH_THRESHOLD=0.9

# Artificial delay for concurrency experiments; keep 0 for normal use.
MODEL_DELAY_SECONDS=0

# GLEIF tiebreak for low-confidence matches (calls the public GLEIF API).
GLEIF_ENABLED=false
GLEIF_LOW_THRESHOLD=0.6
GLEIF_DAILY_BUDGET=1000
GLEIF_TIMEOUT=5

# Spreadsheet upload limits. Files are deleted upload_ttl_seconds after upload.
# UPLOAD_DIR=/tmp/entity-resolver-uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_ROWS=5000
UPLOAD_TTL_SECONDS=3600
UPLOAD_MAX_RUNNING=3

# --- Abuse and cost protection -----------------------------------------------
# Shared secret sent as the X-API-Key header. Unset = open (the public demo). When
# set it is required on /resolve/batch and /metrics.
# API_KEY=change-me
# Also require it on /resolve and /upload*. The web page cannot send a key, so this
# turns the page off; use it for a script-only deployment.
API_KEY_PROTECT_ALL=false
# Requests per client address per minute (0 = no limit).
RATE_LIMIT_RESOLVE_PER_MIN=120
RATE_LIMIT_BATCH_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_MIN=20
# Largest JSON body, and names per /resolve/batch call.
MAX_BODY_BYTES=262144
BATCH_MAX_NAMES=100
# Wikidata: lookups in flight at once, how long a request waits for a slot before
# a 503, retries per API call (timeouts and 5xx only), and the circuit breaker.
WIKIDATA_MAX_CONCURRENT=4
WIKIDATA_QUEUE_SECONDS=5
WIKIDATA_RETRIES=2
WIKIDATA_BREAKER_FAILURES=5
WIKIDATA_BREAKER_SECONDS=30

# --- Observability -------------------------------------------------------------
# json (one object per line, with a request id) or text.
LOG_FORMAT=json
LOG_LEVEL=INFO
# Reported by /health. In Docker set it at build time (see compose.yml).
# BUILD_ID=dev
