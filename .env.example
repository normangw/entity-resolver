# Development settings (example). Copy to .env and edit; every setting is listed.
# A line starting with "# KEY=" is a setting left at its default on purpose.
# tests/test_env_files.py checks that this file and .env.production.example list
# exactly the settings in src/entity_resolver/config.py.

# development or production. Production refuses to start without API_KEY and JSON logs.
ENVIRONMENT=development
APP_NAME="Entity Resolver API"
DEBUG=false

# --- Model (local alias index) -------------------------------------------------
# Alias index. Unset = the bundled 5-company seed. In Docker the full index lives in
# the alias-index volume at /data/index/companies.full.json (scripts/load_index.sh).
# For the full index locally:
# ALIAS_INDEX_PATH=data/companies.full.json
# RapidFuzz scorer: ratio, WRatio or token_set_ratio. Swapping is an edit here and a
# restart; re-check MATCH_THRESHOLD with scripts/evaluate.py (see eval/README.md).
SCORER=ratio
MATCH_THRESHOLD=0.9
# Artificial delay for concurrency experiments; keep 0 for normal use.
MODEL_DELAY_SECONDS=0

# --- Wikidata fallback -----------------------------------------------------------
# Ask Wikidata when a name is not in the local index (resolves subsidiaries).
WIKIDATA_FALLBACK=true
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
# Seconds per API call, and for one whole lookup (no call starts after it).
WIKIDATA_TIMEOUT=10
WIKIDATA_DEADLINE_SECONDS=15
# A 429 with Retry-After up to this many seconds is waited out once per lookup;
# a longer one becomes our 503 with the same Retry-After.
WIKIDATA_MAX_RETRY_AFTER=2
# Seconds to remember a Wikidata answer; 0 turns the cache off.
WIKIDATA_CACHE_TTL=3600
# Lookups in flight at once, how long a request waits for a slot before a 503,
# retries per API call (timeouts and 5xx), and the circuit breaker.
WIKIDATA_MAX_CONCURRENT=4
WIKIDATA_QUEUE_SECONDS=5
WIKIDATA_RETRIES=2
WIKIDATA_BREAKER_FAILURES=5
WIKIDATA_BREAKER_SECONDS=30

# --- GLEIF tiebreak for low-confidence matches (calls the public GLEIF API) -----
GLEIF_ENABLED=false
# Must be below MATCH_THRESHOLD when GLEIF is on (checked at startup).
GLEIF_LOW_THRESHOLD=0.6
GLEIF_DAILY_BUDGET=1000
GLEIF_TIMEOUT=5

# --- Spreadsheet uploads. Files are deleted UPLOAD_TTL_SECONDS after upload. ----
# UPLOAD_DIR=/tmp/entity-resolver-uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_ROWS=5000
UPLOAD_TTL_SECONDS=3600
UPLOAD_MAX_RUNNING=3

# --- Abuse and cost protection -----------------------------------------------
# Shared secret, sent as X-API-Key or Authorization: Bearer. Unset = open (the
# public demo). When set it is required on /resolve/batch and /metrics.
# API_KEY=
# Also require it on /resolve and /upload*. The web page cannot send a key, so this
# turns the page off; use it for a script-only deployment.
API_KEY_PROTECT_ALL=false
# Requests per client address per minute (0 = no limit).
RATE_LIMIT_RESOLVE_PER_MIN=120
RATE_LIMIT_BATCH_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_MIN=20
# Largest JSON body, names per /resolve/batch call, and the batch's time budget.
MAX_BODY_BYTES=262144
BATCH_MAX_NAMES=100
BATCH_BUDGET_SECONDS=60

# --- Observability -------------------------------------------------------------
# json (one object per line, with a request id) or text.
LOG_FORMAT=json
LOG_LEVEL=INFO
# Reported by /health. In Docker it is set at build time (see compose.yml); a value
# here would override the image's.
# BUILD_ID=dev

# --- Reverse proxy (read by Caddy through compose.yml, not by the app) ---------
# ":80" serves plain HTTP for a local `docker compose up -d`.
SITE_ADDRESS=:80
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
