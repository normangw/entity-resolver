# Production settings (example). Copy to .env on the server and edit; every setting
# is listed. A line starting with "# KEY=" is left at its default on purpose.
# tests/test_env_files.py checks that this file and .env.example list exactly the
# settings in src/entity_resolver/config.py. Never commit the real .env.

# production: the app refuses to start without API_KEY (16+ characters) and JSON logs.
ENVIRONMENT=production
APP_NAME="Entity Resolver API"
DEBUG=false

# --- Model (local alias index) -------------------------------------------------
# The full index, loaded into the alias-index volume by scripts/load_index.sh.
ALIAS_INDEX_PATH=/data/index/companies.full.json
# ratio, WRatio or token_set_ratio. Change it only with a matching MATCH_THRESHOLD
# (eval/README.md); then restart: docker compose up -d
SCORER=ratio
MATCH_THRESHOLD=0.9
MODEL_DELAY_SECONDS=0

# --- Wikidata fallback -----------------------------------------------------------
WIKIDATA_FALLBACK=true
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
# Seconds per API call, and for one whole lookup. Worst case per lookup: queue 5 +
# deadline 15 + one call 5 = 25 s, well inside Caddy's 120 s (docs/time-limits.md).
WIKIDATA_TIMEOUT=5
WIKIDATA_DEADLINE_SECONDS=15
WIKIDATA_MAX_RETRY_AFTER=2
WIKIDATA_CACHE_TTL=3600
WIKIDATA_MAX_CONCURRENT=4
WIKIDATA_QUEUE_SECONDS=5
WIKIDATA_RETRIES=2
WIKIDATA_BREAKER_FAILURES=5
WIKIDATA_BREAKER_SECONDS=30

# --- GLEIF tiebreak ---------------------------------------------------------------
GLEIF_ENABLED=false
GLEIF_LOW_THRESHOLD=0.6
GLEIF_DAILY_BUDGET=1000
GLEIF_TIMEOUT=5

# --- Spreadsheet uploads -----------------------------------------------------------
# The image sets UPLOAD_DIR=/data/uploads, the uploads volume; leave it.
# UPLOAD_DIR=/data/uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_ROWS=5000
UPLOAD_TTL_SECONDS=3600
UPLOAD_MAX_RUNNING=3

# --- Abuse and cost protection -------------------------------------------------
# Required in production. Generate one with: openssl rand -hex 32
# It guards /resolve/batch and /metrics (Prometheus sends it as a bearer token).
API_KEY=
API_KEY_PROTECT_ALL=false
RATE_LIMIT_RESOLVE_PER_MIN=120
RATE_LIMIT_BATCH_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_MIN=20
MAX_BODY_BYTES=262144
BATCH_MAX_NAMES=100
BATCH_BUDGET_SECONDS=60

# --- Observability -------------------------------------------------------------
# Production requires json.
LOG_FORMAT=json
LOG_LEVEL=INFO
# Set at image build time by CI; a value here would override the image's.
# BUILD_ID=

# --- Reverse proxy (read by Caddy through compose.yml, not by the app) ---------
# The instance's DNS name. Caddy gets a Let's Encrypt certificate for it, so ports
# 80 and 443 must be open in the Jetstream security group.
SITE_ADDRESS=<instance>.<project>.projects.jetstream-cloud.org
# If Let's Encrypt rate-limits us, switch to its staging CA to keep demoing
# (browsers will warn): https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
