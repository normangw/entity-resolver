      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source, status) (rate(resolutions_total[5m]))",
          "legendFormat": "{{source}} {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "entity-prometheus"
          },
          "instant": false,
          "range": true
